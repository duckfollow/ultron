{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultron",
  "version": "0.1.0-alpha.4",
  "identifier": "com.duckfollow.ultron",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1432",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ultron \u2014 Terminal",
        "width": 1240,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/128x128.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-"
    },
    "resources": [
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.txt"
    ]
  }
}
